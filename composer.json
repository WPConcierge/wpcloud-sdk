{
    "name": "wpconcierge/wpcloud-sdk",
    "description": "A complete, 1:1 PHP SDK for the WP Cloud (Automattic Atomic) API.",
    "type": "library",
    "keywords": ["wp-cloud", "wpcloud", "atomic", "wordpress", "sdk", "api"],
    "homepage": "https://github.com/WPConcierge/wpcloud-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Sarah Savage",
            "email": "sarah@wpconcierge.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "symfony/http-client": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "phpstan/phpstan": "^1.12",
        "laminas/laminas-coding-standard": "^3.1",
        "slevomat/coding-standard": "^8.15"
    },
    "autoload": {
        "psr-4": {
            "WPConcierge\\WPCloud\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WPConcierge\\WPCloud\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
